# ── LLM (comma-separated lists so you can cascade / rotate) ────────────────
# Keys are tried in order; each key is paired with each model before moving on.
GEMINI_API_KEYS=your_key_here
# Tried top to bottom. When one is rate-limited (429 / RESOURCE_EXHAUSTED)
# the client drops to the next one and the exhausted model is put on cooldown.
GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite

# ── Instagram Graph API (Instagram Login) ───────────────────────────────────
# This is the "Instagram API with Instagram Login" setup, NOT Threads and NOT
# the Facebook-Login variant. Steps:
#   1. developers.facebook.com -> create a Business-type app (use case: Other)
#   2. Add Product -> Instagram -> "API setup with Instagram login"
#   3. Keep the token scopes Meta defaults to:
#        instagram_business_basic, instagram_business_content_publish,
#        instagram_business_manage_insights
#      (remove the messaging/comment-management ones you won't use)
#   4. "Add Instagram account" -> log in -> copy the IG User ID and the
#      long-lived Access Token below. Your Instagram account must be a
#      Professional (Business or Creator) account, not Personal.
# Verify with: accelerated-devops check-token
IG_USER_ID=
IG_ACCESS_TOKEN=
# PAGE_ID is only for the legacy Facebook-Login path; leave empty with
# Instagram Login.
PAGE_ID=

# ── Where the rendered slides are hosted ───────────────────────────────────
# Instagram downloads each image from a *public URL* itself, while it creates
# the container, so the slides have to be live before the API call. This app
# does not host them: they sit on the gh-pages site, and the publish path needs
# nothing but that site's root.
#
# Every slide URL is
#     <PUBLIC_ASSET_BASE_URL>/<fingerprint>/<fingerprint>_NN.jpg
# which is the layout the renderer writes under its output directory, so put
# the slides there. Must be https and reachable from the public internet:
#     https://<owner>.github.io/<repo>
PUBLIC_ASSET_BASE_URL=

# One-time repo setup: Settings -> Pages -> Deploy from a branch ->
# gh-pages / (root). The branch itself is created on the first state commit.


# ── Brand / voice ──────────────────────────────────────────────────────────
BRAND_NAME=Accelerated DevOps
BRAND_HANDLE=@accelerated.devops
BRAND_TAGLINE=Platform engineering, decoded.

# ── Collection tuning ──────────────────────────────────────────────────────
LOOKBACK_HOURS=72
# HN needs a wider window: infra stories are sparse week to week, so the
# relevance filter (not the score) is what keeps it on-niche.
HN_LOOKBACK_HOURS=720
MIN_HN_POINTS=60
MIN_REDDIT_COMMENTS=40
# Reddit OAuth (optional but recommended). Register a "script" app at
# https://www.reddit.com/prefs/apps, then request Data API access and wait for
# approval - unauthenticated .json is 403 from most datacentre IPs, while an
# approved app gets 100 queries/minute against oauth.reddit.com.
# client_id is the short string under "personal use script".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a real contact address in the User-Agent. Unset means the
# fallback string, which is a fair bit less likely to be taken seriously.
SOURCE_CONTACT_EMAIL=
POSTS_PER_RUN=2
MAX_CAROUSEL_SLIDES=8
# 0.0 = calm engineering writing, 1.0 = aggressive engagement bait
HOOK_INTENSITY=0.55

# ── Monetisation (leave off until the account has traction) ────────────────
MONETIZATION_ENABLED=false
CTA_TEXT=Full write-up and config in bio.
AFFILIATE_URL=

# ── Scheduling (local time, HH:MM) ─────────────────────────────────────────
PUBLISH_SLOTS=09:15,17:45

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite DB, draft JSON and rendered PNGs all live under here.
DATA_DIR=data
